# Copy this file to .env. Never commit real credentials.
DB_HOST=localhost
DB_PORT=3307
DB_USER=instacart
DB_PASSWORD=change-me
DB_NAME=instacart_dwh

# Local container-only operations. Use distinct non-production values.
MARIADB_ROOT_PASSWORD=change-root-password

# Directory containing the six Kaggle Instacart CSV files.
DATA_PATH=./data

# Optional when installed outside the repository; containers set this to /app.
# INSTACART_PROJECT_ROOT=/absolute/path/to/project

# ETL tuning. Start conservatively, then benchmark on your machine.
BATCH_SIZE=1000
CHUNK_SIZE=50000

# dashboard mode: auto (live with demo fallback), live, or demo
DASHBOARD_MODE=auto
DASHBOARD_CACHE_TTL=3600
DASHBOARD_PORT=8501

# Mining defaults keep local runs bounded and reproducible.
MINING_RANDOM_STATE=42
MINING_ORDER_LIMIT=100000
